# Supabase Configuration
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Amplitude API Key
EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key-here

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Web app base URL for CDN-cached leaderboard reads (e.g. https://forked.example).
# Optional: when unset, leaderboard queries fall back to the Supabase RPC.
EXPO_PUBLIC_WEB_API_URL=

# Google Sign-In (native)
# Web client id is what Supabase validates Google id tokens against; iOS client id is used by the native SDK.
# The iOS URL scheme is the reversed iOS client id (e.g. com.googleusercontent.apps.123-abc).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-reversed-ios-client-id