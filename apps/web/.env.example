# Supabase — dev project for local work (see supabase/ENVIRONMENTS.md).
# Prod values live in Vercel's project settings, never in this repo.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Marketing gate: true renders the waitlist landing page instead of the full site.
NEXT_PUBLIC_WAITLIST_MODE=boolean

# Canonical site origin used by sitemap/SEO metadata.
# Optional locally — falls back to https://forkedapp.com when unset.
NEXT_PUBLIC_SITE_URL=

# Shared secret for POST /api/revalidate. The route returns 401 while this is unset,
# which is the correct local default unless you're testing on-demand revalidation.
REVALIDATION_TOKEN=
