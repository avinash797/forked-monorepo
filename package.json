{
  "name": "forked-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "start:mobile": "npm run start -w forked",
    "ios": "npm run ios -w forked",
    "android": "npm run android -w forked",
    "dev:web": "npm run dev -w forked-web",
    "build:web": "npm run build -w forked-web",
    "start:web": "npm run start -w forked-web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "gen:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "gen:theme": "npm run gen:css -w @forked/theme",
    "db:push": "node -e \"console.error('db:push is ambiguous \\u2014 use db:push:dev or db:push:prod (see supabase/ENVIRONMENTS.md)');process.exit(1)\"",
    "gen:types:remote": "node -e \"console.error('gen:types:remote is ambiguous \\u2014 use gen:types (local) or gen:types:dev');process.exit(1)\"",
    "sb": "./scripts/supabase-env.sh",
    "supabase:status": "./scripts/supabase-status.sh",
    "db:check:dev": "./scripts/supabase-env.sh dev migration list",
    "db:check:prod": "./scripts/supabase-env.sh prod migration list",
    "db:push:dev:dry": "./scripts/supabase-env.sh dev db push --dry-run",
    "db:push:dev": "./scripts/supabase-env.sh dev db push",
    "db:push:prod:dry": "./scripts/supabase-env.sh prod db push --dry-run",
    "db:push:prod": "./scripts/supabase-env.sh prod db push",
    "db:reset:dev": "./scripts/supabase-env.sh dev db reset",
    "db:dump:dev": "./scripts/supabase-env.sh dev db dump",
    "db:dump:prod": "./scripts/supabase-env.sh prod db dump",
    "gen:types:dev": "./scripts/supabase-env.sh dev gen types typescript > packages/supabase/src/database.types.ts",
    "fn:deploy:dev": "./scripts/supabase-env.sh dev functions deploy",
    "fn:deploy:prod": "./scripts/supabase-env.sh prod functions deploy",
    "seed:nola": "node scripts/seed-nola/index.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0"
  }
}
