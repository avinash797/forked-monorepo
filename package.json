{
  "name": "forked-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "start:mobile": "npm run start -w forked",
    "ios": "npm run ios -w forked",
    "android": "npm run android -w forked",
    "dev:web": "npm run dev -w forked-web",
    "build:web": "npm run build -w forked-web",
    "start:web": "npm run start -w forked-web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:migration": "supabase migration new",
    "gen:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "gen:types:remote": "supabase gen types typescript --linked > packages/supabase/src/database.types.ts",
    "gen:theme": "npm run gen:css -w @forked/theme"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0"
  }
}
